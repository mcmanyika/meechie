rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public give pages read published donate-button profiles.
    // Staff publish while signed in (Firebase Auth).
    match /givingProfiles/{slug} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Written by the Stripe webhook / session API via the Firebase client
    // on the server. Keep locked down once Admin SDK is wired; for now
    // server writes use the web SDK without a user token, so allow create
    // only when the payload looks like a Stripe session notice.
    match /stripeNotices/{sessionId} {
      allow read: if true;
      allow create, update: if sessionId.matches('cs_.*');
      allow delete: if false;
    }
  }
}
