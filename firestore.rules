rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public give-page config (button labels, amounts, program ids). Not secret.
    // Readable by donors; writable so staff publish and the server API both work
    // without Firebase Admin SDK.
    match /givingProfiles/{slug} {
      allow read, write: if true;
    }

    // Stripe Checkout session notices (ids always start with cs_).
    match /stripeNotices/{sessionId} {
      allow read: if true;
      allow create, update: if sessionId.matches('cs_.*');
      allow delete: if false;
    }

    // Staff registration / activation records shared across browsers.
    // Doc id is the lowercased email.
    match /staffAccounts/{email} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }
  }
}
